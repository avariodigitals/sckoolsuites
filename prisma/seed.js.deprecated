async function seed() {
  const school = await prisma.school.upsert({
    where: { id: "default" },
    update: {},
    create: {
      id: "default",
      name: "Test School",
      email: "test@school.com",
      phone: "+2340000000000",
      address: "123 Test Street",
      website: "https://test.school",
      motto: "Knowledge is power",
      isActive: true,
      isSetup: true,
    },
  });

  await prisma.schoolBranding.upsert({
    where: { schoolId: school.id },
    update: {},
    create: {
      schoolId: school.id,
      primaryColor: "#0B1F4D",
      secondaryColor: "#0E9F6E",
      reportCardTheme: "classic",
      invoiceTheme: "clean",
      receiptTheme: "simple",
    },
  });

  await Promise.all(
    roles.map((role) =>
      prisma.role.upsert({
        where: { name: role.name },
        update: { label: role.label, description: role.description },
        create: role,
      })
    )
  );

  // Seed privileges and default role privileges.
  const privilegeRecords = await Promise.all(
    ALL_PRIVILEGES.map((priv) =>
      prisma.privilege.upsert({
        where: { code: priv.code },
        update: { name: priv.name, category: priv.category },
        create: {
          code: priv.code,
          name: priv.name,
          category: priv.category,
          description: null,
        },
      })
    )
  );

  const seededRoles = await prisma.role.findMany();
  const roleIdByName = new Map(seededRoles.map((r) => [r.name, r.id]));
  const privIdByCode = new Map(privilegeRecords.map((p) => [p.code, p.id]));

  for (const [roleName, codes] of Object.entries(DEFAULT_ROLE_PRIVILEGES)) {
    const roleId = roleIdByName.get(roleName);
    if (!roleId) continue;
    for (const code of codes) {
      const privilegeId = privIdByCode.get(code);
      if (!privilegeId) continue;
      try {
        await prisma.rolePrivilege.create({
          data: { roleId, privilegeId, isGranted: true },
        });
      } catch (err) {
        if (err?.code !== "P2002") throw err;
      }
    }
  }

  const adminRole = await prisma.role.findUniqueOrThrow({
    where: { name: "SCHOOL_ADMIN" },
  });

  const hashedPassword = await hash(ADMIN_PASSWORD, 10);

  await prisma.user.upsert({
    where: { email: ADMIN_EMAIL },
    update: {
      name: "Test School Admin",
      roleId: adminRole.id,
      schoolId: school.id,
      password: hashedPassword,
      isActive: true,
    },
    create: {
      name: "Test School Admin",
      email: ADMIN_EMAIL,
      roleId: adminRole.id,
      schoolId: school.id,
      password: hashedPassword,
      isActive: true,
    },
  });

  console.log("Seeded test school, branding, roles, and admin user.");
}

seed()
  .catch((err) => {
    console.error(err);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
