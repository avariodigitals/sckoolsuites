import { Pool, PoolClient, QueryResult, QueryResultRow } from "pg";

function toCamelCase(str: string): string {
  return str.replace(/_([a-z])/g, (_, letter) => letter.toUpperCase());
}

function mapRow(row: any): any {
  if (!row || typeof row !== "object") return row;
  if (row instanceof Date) return row;
  if (Array.isArray(row)) return row.map(mapRow);
  const out: any = {};
  for (const [k, v] of Object.entries(row)) {
    out[toCamelCase(k)] = mapRow(v);
  }
  return out;
}

// Production pool configuration
const isProd = process.env.NODE_ENV === "production";
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: isProd ? { rejectUnauthorized: false } : false,
  max: isProd ? 30 : 20,
  idleTimeoutMillis: 30000,
  connectionTimeoutMillis: 20000,
});

pool.on("error", (err) => {
  console.error("[db] Unexpected pool error:", err.message);
});

// Helper function for queries with error handling
export async function query<T extends QueryResultRow = any>(
  sql: string,
  params?: any[]
): Promise<QueryResult<T>> {
  try {
    return await pool.query<T>(sql, params);
  } catch (err: any) {
    console.error("[db] Query error:", err.message, "| SQL:", sql.substring(0, 120));
    throw err;
  }
}

// Helper for single row queries
export async function queryOne<T extends QueryResultRow = any>(
  sql: string,
  params?: any[]
): Promise<T | null> {
  try {
    const result = await pool.query<T>(sql, params);
    return result.rows[0] || null;
  } catch (err: any) {
    console.error("[db] queryOne error:", err.message, "| SQL:", sql.substring(0, 120));
    throw err;
  }
}

// Helper for many rows
export async function queryMany<T extends QueryResultRow = any>(
  sql: string,
  params?: any[]
): Promise<T[]> {
  try {
    const result = await pool.query<T>(sql, params);
    return result.rows;
  } catch (err: any) {
    console.error("[db] queryMany error:", err.message, "| SQL:", sql.substring(0, 120));
    throw err;
  }
}

// Create model clients that use a specific query function (for transactions)
function createTransactionModelClient(tableName: string, queryFn: typeof query) {
  const queryOneTx = async <T extends QueryResultRow = any>(sql: string, params?: any[]): Promise<T | null> => {
    const result = await queryFn<T>(sql, params);
    return result.rows[0] || null;
  };

  const queryManyTx = async <T extends QueryResultRow = any>(sql: string, params?: any[]): Promise<T[]> => {
    const result = await queryFn<T>(sql, params);
    return result.rows;
  };

  return {
    async findUnique<T extends QueryResultRow = any>({ where, select, include }: { where: Record<string, any>; select?: Record<string, boolean>; include?: Record<string, any> }): Promise<T | null> {
      const { clause, values } = buildWhere(where);
      let columns = "*";
      if (select) {
        const selectedCols = Object.keys(select).filter(k => select[k]).map(k => toSnakeCase(k));
        if (selectedCols.length > 0) columns = selectedCols.join(", ");
      }
      const row = await queryOneTx<T>(`SELECT ${columns} FROM ${tableName} ${clause} LIMIT 1`, values);
      if (!row) return null;
      const rows = await processInclude(tableName, [row], include);
      return mapRow(rows[0]) || null;
    },

    async findFirst<T extends QueryResultRow = any>({ where, include, orderBy, select }: { where?: Record<string, any>; include?: Record<string, any>; orderBy?: Record<string, string>; select?: Record<string, boolean> } = {}): Promise<T | null> {
      const { clause, values } = buildWhere(where || {});
      let columns = "*";
      if (select) {
        const selectedCols = Object.keys(select).filter(k => select[k]).map(k => toSnakeCase(k));
        if (selectedCols.length > 0) columns = selectedCols.join(", ");
      }
      let sql = `SELECT ${columns} FROM ${tableName} ${clause}`;
      if (orderBy) {
        const [key, direction] = Object.entries(orderBy)[0] || [];
        if (key) sql += ` ORDER BY ${toSnakeCase(key)} ${direction || 'ASC'}`;
      }
      const row = await queryOneTx<T>(`${sql} LIMIT 1`, values);
      if (!row) return null;
      const rows = await processInclude(tableName, [row], include);
      return mapRow(rows[0]) || null;
    },

    async findMany<T extends QueryResultRow = any>({ where, orderBy, include, take, select }: { where?: Record<string, any>; orderBy?: Record<string, string> | Array<Record<string, string>>; include?: Record<string, any>; take?: number; select?: Record<string, boolean> } = {}): Promise<T[]> {
      const { clause, values } = buildWhere(where || {});
      let columns = "*";
      if (select) {
        const selectedCols = Object.keys(select).filter(k => select[k]).map(k => toSnakeCase(k));
        if (selectedCols.length > 0) columns = selectedCols.join(", ");
      }
      let sql = `SELECT ${columns} FROM ${tableName} ${clause}`;
      if (orderBy) {
        const orderObj = Array.isArray(orderBy) ? orderBy[0] : orderBy;
        const [key, direction] = Object.entries(orderObj || {})[0] || [];
        if (key) sql += ` ORDER BY ${toSnakeCase(key)} ${direction || 'ASC'}`;
      }
      if (take) sql += ` LIMIT ${take}`;
      const rows = await queryManyTx<T>(sql, values);
      const included = await processInclude(tableName, rows, include);
      return included.map(mapRow);
    },

    async create<T extends QueryResultRow = any>({ data }: { data: Record<string, any> }): Promise<T> {
      const clean: Record<string, any> = {};
      Object.entries(data).forEach(([k, v]) => {
        if (v === undefined) return;
        // user table has no school_id column
        if (tableName === '"user"' && k === "schoolId") return;
        // Strip nested relation objects
        if (v && typeof v === "object" && !Array.isArray(v) && !(v instanceof Date)) {
          if (["data", "create", "connect", "disconnect"].includes(k)) {
            console.warn(`[db shim] Nested relation key "${k}" on ${tableName} stripped`);
            return;
          }
          if (v.create !== undefined || v.connect !== undefined || v.disconnect !== undefined) {
            console.warn(`[db shim] Nested relation "${k}" on ${tableName} stripped`);
            return;
          }
        }
        if (v instanceof Date) { clean[k] = v.toISOString(); return; }
        if (Array.isArray(v) || (typeof v === 'object' && v !== null)) { clean[k] = JSON.stringify(v); return; }
        clean[k] = v;
      });
      const entries = Object.entries(clean).filter(([_, v]) => v !== undefined);
      const columns = entries.map(([k]) => toSnakeCase(k));
      const values = entries.map(([_, v]) => v);
      const placeholders = values.map((_, i) => `$${i + 1}`).join(", ");
      const result = await queryFn<T>(`INSERT INTO ${tableName} (${columns.join(", ")}) VALUES (${placeholders}) RETURNING *`, values);
      return mapRow(result.rows[0]);
    },

    async update<T extends QueryResultRow = any>({ where, data }: { where: Record<string, any>; data: Record<string, any> }): Promise<T> {
      const { clause: whereClause, values: whereValues } = buildWhere(where);
      const setEntries = Object.entries(data).filter(([_, v]) => v !== undefined);
      const setClause = setEntries.map(([k], i) => `${toSnakeCase(k)} = $${i + 1}`).join(", ");
      const setValues = setEntries.map(([_, v]) => v instanceof Date ? v.toISOString() : typeof v === 'object' && v !== null ? JSON.stringify(v) : v);
      const allValues = [...setValues, ...whereValues];
      const adjustedWhereClause = whereClause.replace(/\$(\d+)/g, (_, num) => `$${parseInt(num) + setValues.length}`);
      const result = await queryFn<T>(`UPDATE ${tableName} SET ${setClause} ${adjustedWhereClause} RETURNING *`, allValues);
      return mapRow(result.rows[0]);
    },

    async updateMany({ where, data }: { where: Record<string, any>; data: Record<string, any> }): Promise<{ count: number }> {
      const { clause: whereClause, values: whereValues } = buildWhere(where);
      const setEntries = Object.entries(data).filter(([_, v]) => v !== undefined);
      const setClause = setEntries.map(([k], i) => `${toSnakeCase(k)} = $${i + 1}`).join(", ");
      const setValues = setEntries.map(([_, v]) => v instanceof Date ? v.toISOString() : typeof v === 'object' && v !== null ? JSON.stringify(v) : v);
      const allValues = [...setValues, ...whereValues];
      const adjustedWhereClause = whereClause.replace(/\$(\d+)/g, (_, num) => `$${parseInt(num) + setValues.length}`);
      const result = await queryFn(`UPDATE ${tableName} SET ${setClause} ${adjustedWhereClause}`, allValues);
      return { count: result.rowCount || 0 };
    },

    async delete<T extends QueryResultRow = any>({ where }: { where: Record<string, any> }): Promise<T> {
      const { clause, values } = buildWhere(where);
      const result = await queryFn<T>(`DELETE FROM ${tableName} ${clause} RETURNING *`, values);
      return mapRow(result.rows[0]);
    },

    async deleteMany({ where }: { where?: Record<string, any> } = {}): Promise<{ count: number }> {
      const { clause, values } = buildWhere(where || {});
      const result = await queryFn(`DELETE FROM ${tableName} ${clause}`, values);
      return { count: result.rowCount || 0 };
    },

    async count({ where }: { where?: Record<string, any> } = {}): Promise<number> {
      const { clause, values } = buildWhere(where || {});
      const result = await queryFn<{ count: string }>(`SELECT COUNT(*) as count FROM ${tableName} ${clause}`, values);
      return parseInt(result.rows[0]?.count || "0");
    },

    async aggregate({ where, _sum, _max }: { where?: Record<string, any>; _sum?: Record<string, boolean>; _max?: Record<string, boolean> }): Promise<{ _sum: Record<string, number | null>; _max: Record<string, number | null> }> {
      const { clause, values } = buildWhere(where || {});
      const aggColumns: string[] = [];
      if (_sum) Object.keys(_sum).forEach(k => aggColumns.push(`SUM(${toSnakeCase(k)}) as sum_${toSnakeCase(k)}`));
      if (_max) Object.keys(_max).forEach(k => aggColumns.push(`MAX(${toSnakeCase(k)}) as max_${toSnakeCase(k)}`));
      if (aggColumns.length === 0) return { _sum: {}, _max: {} };
      const result = await queryFn<Record<string, string>>(`SELECT ${aggColumns.join(", ")} FROM ${tableName} ${clause}`, values);
      const row = result.rows[0] || {};
      const sums: Record<string, number | null> = {};
      const maxs: Record<string, number | null> = {};
      if (_sum) Object.keys(_sum).forEach(k => {
        const val = row[`sum_${toSnakeCase(k)}`];
        sums[k] = val === null || val === undefined ? null : Number(val);
      });
      if (_max) Object.keys(_max).forEach(k => {
        const val = row[`max_${toSnakeCase(k)}`];
        maxs[k] = val === null || val === undefined ? null : Number(val);
      });
      return { _sum: sums, _max: maxs };
    },
  };
}

// Create a transaction-scoped prisma-like client
function createTransactionPrisma(client: any) {
  const queryTx = async <T extends QueryResultRow = any>(sql: string, params?: any[]): Promise<QueryResult<T>> => {
    return client.query(sql, params) as Promise<QueryResult<T>>;
  };

  return {
    $queryRaw: queryTx,
    school: createTransactionModelClient("school", queryTx),
    schoolBranding: createTransactionModelClient("school_branding", queryTx),
    role: createTransactionModelClient("role", queryTx),
    user: createTransactionModelClient('"user"', queryTx),
    parent: createTransactionModelClient("parent", queryTx),
    teacher: createTransactionModelClient("teacher", queryTx),
    student: createTransactionModelClient("student", queryTx),
    class: createTransactionModelClient("class", queryTx),
    classGroup: createTransactionModelClient("class_group", queryTx),
    classArm: createTransactionModelClient("class_arm", queryTx),
    subject: createTransactionModelClient("subject", queryTx),
    session: createTransactionModelClient("session", queryTx),
    term: createTransactionModelClient("term", queryTx),
    feeGroup: createTransactionModelClient("fee_group", queryTx),
    feeComponent: createTransactionModelClient("fee_component", queryTx),
    feeItem: createTransactionModelClient("fee_item", queryTx),
    feeProfile: createTransactionModelClient("fee_profile", queryTx),
    feeProfileItem: createTransactionModelClient("fee_profile_item", queryTx),
    feeProfileClass: createTransactionModelClient("fee_profile_class", queryTx),
    feeProfileArm: createTransactionModelClient("fee_profile_arm", queryTx),
    invoice: createTransactionModelClient("invoice", queryTx),
    invoiceItem: createTransactionModelClient("invoice_item", queryTx),
    payment: createTransactionModelClient("payment", queryTx),
    paymentProof: createTransactionModelClient("payment_proof", queryTx),
    receipt: createTransactionModelClient("receipt", queryTx),
    score: createTransactionModelClient("score", queryTx),
    result: createTransactionModelClient("result", queryTx),
    attendance: createTransactionModelClient("attendance", queryTx),
    lesson: createTransactionModelClient("lesson", queryTx),
    assignment: createTransactionModelClient("assignment", queryTx),
    quiz: createTransactionModelClient("quiz", queryTx),
    onlineClass: createTransactionModelClient("online_class", queryTx),
    announcement: createTransactionModelClient("announcement", queryTx),
    schoolSetting: createTransactionModelClient("school_setting", queryTx),
    schoolConfigVersion: createTransactionModelClient("school_config_version", queryTx),
    parentMessage: createTransactionModelClient("parent_message", queryTx),
    parentComplaint: createTransactionModelClient("parent_complaint", queryTx),
    auditLog: createTransactionModelClient("audit_log", queryTx),
    invoiceContestAudit: createTransactionModelClient("invoice_contest_audit", queryTx),
    vehicle: createTransactionModelClient("vehicle", queryTx),
    driver: createTransactionModelClient("driver", queryTx),
    route: createTransactionModelClient("route", queryTx),
    routeStop: createTransactionModelClient("route_stop", queryTx),
    visitor: createTransactionModelClient("visitor", queryTx),
    enquiry: createTransactionModelClient("enquiry", queryTx),
    gatePass: createTransactionModelClient("gate_pass", queryTx),
    receptionComplaint: createTransactionModelClient("reception_complaint", queryTx),
    callLog: createTransactionModelClient("call_log", queryTx),
    correspondence: createTransactionModelClient("correspondence", queryTx),
    query: createTransactionModelClient("query", queryTx),
    incomeCategory: createTransactionModelClient("income_category", queryTx),
    expenseCategory: createTransactionModelClient("expense_category", queryTx),
    income: createTransactionModelClient("income", queryTx),
    expense: createTransactionModelClient("expense", queryTx),
    assessment: createTransactionModelClient("assessment", queryTx),
    classAssessment: createTransactionModelClient("class_assessment", queryTx),
    classGroupAssessment: createTransactionModelClient("class_group_assessment", queryTx),
    studentEnrollment: createTransactionModelClient("student_enrollment", queryTx),
    privilege: createTransactionModelClient("privilege", queryTx),
    rolePrivilege: createTransactionModelClient("role_privilege", queryTx),
    userPrivilege: createTransactionModelClient("user_privilege", queryTx),
    admissionApplication: createTransactionModelClient("admission_application", queryTx),
    admissionGuardian: createTransactionModelClient("admission_guardian", queryTx),
    admissionDocument: createTransactionModelClient("admission_document", queryTx),
    admissionQualification: createTransactionModelClient("admission_qualification", queryTx),
  };
}

// Transaction helper - supports both callback and array forms
export async function withTransaction<T>(
  callback: ((tx: any) => Promise<T>) | Promise<any>[]
): Promise<any> {
  const client = await pool.connect();
  try {
    await client.query("BEGIN");
    let result: T | any[];
    if (Array.isArray(callback)) {
      result = await Promise.all(callback);
    } else {
      const txPrisma = createTransactionPrisma(client);
      result = await callback(txPrisma);
    }
    await client.query("COMMIT");
    return result;
  } catch (error: any) {
    await client.query("ROLLBACK");
    console.error("[db] Transaction failed:", error.message);
    throw error;
  } finally {
    client.release();
  }
}

// For direct client access
export async function getClient(): Promise<PoolClient> {
  return pool.connect();
}

// Graceful shutdown
export async function closePool(): Promise<void> {
  await pool.end();
}

// ============================================================================
// PRISMA COMPATIBILITY SHIM
// This provides a Prisma-like API for easier migration
// ============================================================================

// Helper to convert camelCase to snake_case
function toSnakeCase(str: string): string {
  return str.replace(/[A-Z]/g, letter => `_${letter.toLowerCase()}`);
}

// Helper to build WHERE clauses with operator support
function buildWhere(where: Record<string, any>, paramOffset = 0): { clause: string; values: any[] } {
  const entries = Object.entries(where).filter(([_, v]) => v !== undefined);
  if (entries.length === 0) return { clause: "", values: [] };

  const values: any[] = [];
  const conditions: string[] = [];
  let paramIndex = paramOffset;

  function pushValue(v: any) {
    paramIndex++;
    values.push(v);
    return `$${paramIndex}`;
  }

  function processEntry(key: string, val: any): string {
    // Handle OR array
    if (key === "OR" && Array.isArray(val)) {
      const orParts = val
        .map((item) => {
          const sub = buildWhere(item, paramIndex);
          paramIndex += sub.values.length;
          values.push(...sub.values);
          return sub.clause.replace(/^WHERE /, "");
        })
        .filter(Boolean);
      return orParts.length ? `(${orParts.join(" OR ")})` : "1=1";
    }

    // Handle composite key object like { schoolId_key: { schoolId, key } }
    if (val && typeof val === "object" && !Array.isArray(val) && !(val instanceof Date)) {
      const keys = Object.keys(val);
      if (!keys.includes("not") && !keys.includes("in") && !keys.includes("lt") && !keys.includes("lte") && !keys.includes("gt") && !keys.includes("gte") && !keys.includes("startsWith")) {
        // It's a composite key or relation filter — build nested AND
        const subEntries = Object.entries(val).filter(([_, v]) => v !== undefined);
        const subParts = subEntries.map(([subKey, subVal]) => {
          const col = toSnakeCase(subKey);
          return `${col} = ${pushValue(subVal)}`;
        });
        return subParts.join(" AND ");
      }
    }

    const column = toSnakeCase(key);

    if (val === null) {
      return `${column} IS NULL`;
    }

    if (val && typeof val === "object" && !Array.isArray(val) && !(val instanceof Date)) {
      // Operator object — accumulate all recognized operators
      const ops: string[] = [];
      if ("not" in val) {
        if (val.not === null) ops.push(`${column} IS NOT NULL`);
        else ops.push(`${column} != ${pushValue(val.not)}`);
      }
      if ("in" in val && Array.isArray(val.in)) {
        ops.push(`${column} = ANY(${pushValue(val.in)})`);
      }
      if ("lt" in val) ops.push(`${column} < ${pushValue(val.lt)}`);
      if ("lte" in val) ops.push(`${column} <= ${pushValue(val.lte)}`);
      if ("gt" in val) ops.push(`${column} > ${pushValue(val.gt)}`);
      if ("gte" in val) ops.push(`${column} >= ${pushValue(val.gte)}`);
      if ("startsWith" in val) ops.push(`${column} LIKE ${pushValue(val.startsWith + "%")}`);
      if (ops.length > 0) return ops.join(" AND ");
    }

    return `${column} = ${pushValue(val)}`;
  }

  for (const [key, val] of entries) {
    const cond = processEntry(key, val);
    if (cond) conditions.push(cond);
  }

  return {
    clause: conditions.length ? `WHERE ${conditions.join(" AND ")}` : "",
    values,
  };
}

