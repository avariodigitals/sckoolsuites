# SckoolSuite ERP - Environment Configuration Example
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local or any other secret file to Git.

# ==========================================
# DATABASE (REQUIRED)
# ==========================================
# Runtime PostgreSQL connection string used by the application.
# Examples:
#   Neon:        postgresql://user:pass@host-pooler.c-REGION.aws.neon.tech/neondb?sslmode=verify-full
#   Railway:     postgresql://user:pass@containers.railway.app:5432/railway
#   Supabase:    postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#   Self-hosted: postgresql://sckooladmin:password@your-server-ip:5432/sckoolsuite
#   Local:       postgresql://user@localhost:5432/sckoolsuite
DATABASE_URL="postgresql://user:password@localhost:5432/sckoolsuite"

# Optional: direct PostgreSQL connection for Prisma migrations / admin commands.
# Use the direct (non-pooled) endpoint from your provider (e.g. Neon's "Direct" connection or Supabase's db. host).
# If omitted, Prisma CLI commands use DATABASE_URL instead.
# DIRECT_URL="postgresql://user:pass@host.c-REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Optional: maximum PostgreSQL pool size (default: 10). Increase only when needed.
# PG_POOL_MAX=10
# DB_POOL_MAX=10

# Optional: pool tuning (defaults are conservative for managed providers).
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000

# Explicit operator override to disable SSL for trusted local PostgreSQL only.
# NEVER set this for Neon / managed providers.
# PG_SSL_DISABLED=true

# ==========================================
# AUTHENTICATION (REQUIRED)
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-32-character-secret"

# ==========================================
# FILE UPLOADS (REQUIRED)
# ==========================================
# Cloudinary credentials for logos, avatars, payment proofs, and templates.
# Sign up free at https://cloudinary.com.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional: prepend a base folder to all Cloudinary uploads
# CLOUDINARY_BASE_FOLDER="sckoolsuite"

# ==========================================
# OPTIONAL: EMAIL NOTIFICATIONS (Resend)
# ==========================================
# RESEND_API_KEY="re_xxxxxxxx"
# FROM_EMAIL="noreply@yourdomain.com"
# RESEND_FROM_EMAIL="noreply@yourdomain.com"
# EMAIL_WEBHOOK_URL="https://your-webhook.example.com/email"

# ==========================================
# OPTIONAL: PUBLIC APP URL
# ==========================================
# Used in email links when NEXTAUTH_URL is not suitable.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# OPTIONAL: PUSH NOTIFICATIONS (Web Push)
# ==========================================
# VAPID keys for sending push notifications to PWA-installed devices.
# Generate with: npx web-push generate-vapid-keys
# The public key is safe to expose to the client.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="BGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# VAPID_SUBJECT="mailto:admin@yourschool.com"

# ==========================================
# NODE ENVIRONMENT
# ==========================================
NODE_ENV="development"
# For production: "production"

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
# 1. cp .env.example .env.local
# 2. Fill in all REQUIRED values above.
# 3. Generate a strong NEXTAUTH_SECRET.
# 4. Run: npm run db:setup
# 5. Start the app: npm run dev
# 6. Open http://localhost:3000/setup and complete the wizard.
